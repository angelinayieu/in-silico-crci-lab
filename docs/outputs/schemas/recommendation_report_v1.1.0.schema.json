        "study_count": {
          "default": 0,
          "title": "Study Count",
          "type": "integer"
        },
        "overall_completeness": {
          "default": 0.0,
          "title": "Overall Completeness",
          "type": "number"
        },
        "total_defaults_fired": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Aggregate defaults per layer: {'L1': 0, 'L4': 2, 'L6': 5, ...}",
          "title": "Total Defaults Fired",
          "type": "object"
        },
        "missing_families_summary": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Family code \u2192 count of studies missing it: {'F4': 3}",
          "title": "Missing Families Summary",
          "type": "object"
        },
        "blocking_issue_count": {
          "default": 0,
          "title": "Blocking Issue Count",
          "type": "integer"
        },
        "quality_caveats": {
          "description": "Human-readable quality warnings for presentation layer",
          "items": {
            "type": "string"
          },
          "title": "Quality Caveats",
          "type": "array"
        }
      },
      "title": "ExtractionQualitySummary",
      "type": "object"
    },

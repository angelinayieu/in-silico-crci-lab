{
  "$defs": {
    "ClinicalRiskProfile": {
      "description": "Clinical CRCI risk assessment with domain decomposition.\n\nThis is a MODEL-DERIVED probability, not a clinically calibrated rate.\nSee calibration_status field and \u00a75.3 of IMPLEMENTATION_PLAN_RISK_PERCENTAGE.\n\nProduced by: risk_estimator.py (F4)\nConsumed by: report_assembler.py \u2192 risk_dashboard.py (PRES)",
      "properties": {
        "risk_pct": {
          "title": "Risk Pct",
          "type": "number"
        },
        "risk_lower_pct": {
          "title": "Risk Lower Pct",
          "type": "number"
        },
        "risk_upper_pct": {
          "title": "Risk Upper Pct",
          "type": "number"
        },
        "risk_range_text": {
          "title": "Risk Range Text",
          "type": "string"
        },
        "risk_tier": {
          "title": "Risk Tier",
          "type": "string"
        },
        "interval_method": {
          "title": "Interval Method",
          "type": "string"
        },
        "interval_level": {
          "default": 0.9,
          "title": "Interval Level",
          "type": "number"
        },
        "mc_se": {
          "default": 0.0,
          "title": "Mc Se",
          "type": "number"
        },
        "n_draws_used": {
          "default": 0,
          "title": "N Draws Used",
          "type": "integer"
        },
        "criteria": {
          "default": "ICCTF_Wefel2011_domain_level",
          "title": "Criteria",
          "type": "string"
        },
        "domain_aggregation": {
          "default": "mean",
          "title": "Domain Aggregation",
          "type": "string"
        },
        "calibration_status": {
          "default": "uncalibrated_model_derived",
          "title": "Calibration Status",
          "type": "string"
        },
        "coverage_fraction": {
          "default": 0.0,
          "title": "Coverage Fraction",
          "type": "number"
        },
        "low_coverage_warning": {
          "default": false,
          "title": "Low Coverage Warning",
          "type": "boolean"
        },
        "conditioning": {
          "default": "posterior_at_t",
          "title": "Conditioning",
          "type": "string"
        },
        "thresholds": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Thresholds",
          "type": "object"
        },
        "domain_breakdown": {
          "items": {
            "$ref": "#/$defs/DomainRiskBreakdown"
          },
          "title": "Domain Breakdown",
          "type": "array"
        }
      },
      "required": [
        "risk_pct",
        "risk_lower_pct",
        "risk_upper_pct",
        "risk_range_text",
        "risk_tier",
        "interval_method"
      ],
      "title": "ClinicalRiskProfile",
      "type": "object"
    },
    "CompositeScore": {
      "description": "CRCI Composite Score \u2014 severity-weighted mean across subdomains.\n\nPopulation-normed percentile.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "subject_ref": {
          "title": "Subject Ref",
          "type": "string"
        },
        "composite_z": {
          "title": "Composite Z",
          "type": "number"
        },
        "composite_percentile": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Composite Percentile"
        },
        "overall_severity": {
          "$ref": "#/$defs/SeverityTier"
        },
        "domain_scores": {
          "items": {
            "$ref": "#/$defs/DomainScore"
          },
          "title": "Domain Scores",
          "type": "array"
        },
        "population_norm_used": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population Norm Used"
        },
        "calibration_mode": {
          "default": "index_mode",
          "title": "Calibration Mode",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "subject_ref",
        "composite_z",
        "overall_severity"
      ],
      "title": "CompositeScore",
      "type": "object"
    },
    "DecisionTrace": {
      "description": "Full decision audit trail for transparency.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/DecisionTraceEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "decision_critical_edges": {
          "items": {
            "type": "string"
          },
          "title": "Decision Critical Edges",
          "type": "array"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "DecisionTrace",
      "type": "object"
    },
    "DecisionTraceEntry": {
      "description": "Single decision in the audit trail.",
      "properties": {
        "step": {
          "title": "Step",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "object"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "step",
        "description",
        "outcome"
      ],
      "title": "DecisionTraceEntry",
      "type": "object"
    },
    "DiffEffectSummary": {
      "description": "Differential intervention effect between two contexts (F5-M4).",
      "properties": {
        "intervention_id": {
          "title": "Intervention Id",
          "type": "string"
        },
        "context_a": {
          "title": "Context A",
          "type": "string"
        },
        "context_b": {
          "title": "Context B",
          "type": "string"
        },
        "delta_C_diff_mean": {
          "title": "Delta C Diff Mean",
          "type": "number"
        },
        "delta_C_diff_ci_lower": {
          "title": "Delta C Diff Ci Lower",
          "type": "number"
        },
        "delta_C_diff_ci_upper": {
          "title": "Delta C Diff Ci Upper",
          "type": "number"
        },
        "baseline_contribution": {
          "title": "Baseline Contribution",
          "type": "number"
        },
        "mechanism_contribution": {
          "title": "Mechanism Contribution",
          "type": "number"
        },
        "practically_different": {
          "title": "Practically Different",
          "type": "boolean"
        },
        "decomposition_scoring_policy": {
          "title": "Decomposition Scoring Policy",
          "type": "string"
        }
      },
      "required": [
        "intervention_id",
        "context_a",
        "context_b",
        "delta_C_diff_mean",
        "delta_C_diff_ci_lower",
        "delta_C_diff_ci_upper",
        "baseline_contribution",
        "mechanism_contribution",
        "practically_different",
        "decomposition_scoring_policy"
      ],
      "title": "DiffEffectSummary",
      "type": "object"
    },
    "DomainRiskBreakdown": {
      "description": "Per-domain risk decomposition for clinical display.\n\nThree complementary views per domain (\u00a72.5):\n  A. marginal_risk_pct \u2014 P(this domain is impaired) (Formula F4-4)\n  B. trigger_share_pct \u2014 trigger-share attribution (NOT Shapley, \u00a72.5B)\n  C. ivw_weight_pct   \u2014 precision influence (separate from risk, \u00a72.5C)",
      "properties": {
        "domain_id": {
          "title": "Domain Id",
          "type": "string"
        },
        "domain_label": {
          "title": "Domain Label",
          "type": "string"
        },
        "node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Node Ids",
          "type": "array"
        },
        "marginal_risk_pct": {
          "title": "Marginal Risk Pct",
          "type": "number"
        },
        "trigger_share_pct": {
          "title": "Trigger Share Pct",
          "type": "number"
        },
        "ivw_weight_pct": {
          "title": "Ivw Weight Pct",
          "type": "number"
        },
        "mean_z": {
          "title": "Mean Z",
          "type": "number"
        },
        "sd_z": {
          "title": "Sd Z",
          "type": "number"
        },
        "z_5th": {
          "title": "Z 5Th",
          "type": "number"
        },
        "z_95th": {
          "title": "Z 95Th",
          "type": "number"
        },
        "is_directly_observed": {
          "title": "Is Directly Observed",
          "type": "boolean"
        },
        "n_observations": {
          "default": 0,
          "title": "N Observations",
          "type": "integer"
        }
      },
      "required": [
        "domain_id",
        "domain_label",
        "marginal_risk_pct",
        "trigger_share_pct",
        "ivw_weight_pct",
        "mean_z",
        "sd_z",
        "z_5th",
        "z_95th",
        "is_directly_observed"
      ],
      "title": "DomainRiskBreakdown",
      "type": "object"
    },
    "DomainScore": {
      "description": "Single cognitive domain score.",

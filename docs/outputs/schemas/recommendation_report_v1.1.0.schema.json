{
  "$defs": {
    "ClinicalRiskProfile": {
      "description": "CRCI Risk Percentage output \u2014 probability of meeting ICCTF criteria.\n\nComputed by Chain F4 (risk_estimator.py) from Monte Carlo draws.",
      "properties": {
        "risk_pct": {
          "title": "Risk Pct",
          "type": "number"
        },
        "risk_lower_pct": {
          "title": "Risk Lower Pct",
          "type": "number"
        },
        "risk_upper_pct": {
          "title": "Risk Upper Pct",
          "type": "number"
        },
        "risk_range_text": {
          "default": "",
          "title": "Risk Range Text",
          "type": "string"
        },
        "risk_tier": {
          "default": "UNKNOWN",
          "title": "Risk Tier",
          "type": "string"
        },
        "interval_method": {
          "default": "jeffreys",
          "title": "Interval Method",
          "type": "string"
        },
        "interval_level": {
          "default": 0.9,
          "title": "Interval Level",
          "type": "number"
        },
        "mc_se": {
          "default": 0.0,
          "title": "Mc Se",
          "type": "number"
        },
        "n_draws_used": {
          "default": 0,
          "title": "N Draws Used",
          "type": "integer"
        },
        "coverage_fraction": {
          "default": 0.0,
          "title": "Coverage Fraction",
          "type": "number"
        },
        "low_coverage_warning": {
          "default": false,
          "title": "Low Coverage Warning",
          "type": "boolean"
        },
        "domain_breakdown": {
          "items": {
            "$ref": "#/$defs/DomainRiskBreakdown"
          },
          "title": "Domain Breakdown",
          "type": "array"
        }
      },
      "required": [
        "risk_pct",
        "risk_lower_pct",
        "risk_upper_pct"
      ],
      "title": "ClinicalRiskProfile",
      "type": "object"
    },
    "CompositeScore": {
      "description": "CRCI Composite Score \u2014 severity-weighted mean across subdomains.\n\nPopulation-normed percentile.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "subject_ref": {
          "title": "Subject Ref",
          "type": "string"
        },
        "composite_z": {
          "title": "Composite Z",
          "type": "number"
        },
        "composite_percentile": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Composite Percentile"
        },
        "overall_severity": {
          "$ref": "#/$defs/SeverityTier"
        },
        "domain_scores": {
          "items": {
            "$ref": "#/$defs/DomainScore"
          },
          "title": "Domain Scores",
          "type": "array"
        },
        "population_norm_used": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population Norm Used"
        },
        "calibration_mode": {
          "default": "index_mode",
          "title": "Calibration Mode",
          "type": "string"
        },
        "cochrans_Q": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cochrans Q"
        },
        "I_squared": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "I Squared"
        },
        "random_effects_applied": {
          "default": false,
          "title": "Random Effects Applied",
          "type": "boolean"
        }
      },
      "required": [
        "run_id",
        "subject_ref",
        "composite_z",
        "overall_severity"
      ],
      "title": "CompositeScore",
      "type": "object"
    },
    "DecisionTrace": {
      "description": "Full decision audit trail for transparency.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },

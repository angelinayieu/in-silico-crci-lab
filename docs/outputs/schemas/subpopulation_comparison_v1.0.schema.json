{
  "$defs": {
    "DifferentialEffectSummary": {
      "description": "Pairwise intervention effect comparison across two contexts.",
      "properties": {
        "intervention_id": {
          "title": "Intervention Id",
          "type": "string"
        },
        "context_a": {
          "title": "Context A",
          "type": "string"
        },
        "context_b": {
          "title": "Context B",
          "type": "string"
        },
        "delta_C_diff_mean": {
          "title": "Delta C Diff Mean",
          "type": "number"
        },
        "delta_C_diff_ci_lower": {
          "title": "Delta C Diff Ci Lower",
          "type": "number"
        },
        "delta_C_diff_ci_upper": {
          "title": "Delta C Diff Ci Upper",
          "type": "number"
        },
        "practically_different": {
          "default": false,
          "title": "Practically Different",
          "type": "boolean"
        }
      },
      "required": [
        "intervention_id",
        "context_a",
        "context_b",
        "delta_C_diff_mean",
        "delta_C_diff_ci_lower",
        "delta_C_diff_ci_upper"
      ],
      "title": "DifferentialEffectSummary",
      "type": "object"
    },
    "RiskDifferentialSummary": {
      "description": "Pairwise CRCI risk comparison across two contexts.",
      "properties": {
        "context_a": {
          "title": "Context A",
          "type": "string"
        },
        "context_b": {
          "title": "Context B",
          "type": "string"
        },
        "risk_diff_pct": {
          "title": "Risk Diff Pct",
          "type": "number"
        },
        "risk_diff_ci_lower": {
          "title": "Risk Diff Ci Lower",
          "type": "number"
        },
        "risk_diff_ci_upper": {
          "title": "Risk Diff Ci Upper",
          "type": "number"
        }
      },
      "required": [
        "context_a",
        "context_b",
        "risk_diff_pct",
        "risk_diff_ci_lower",
        "risk_diff_ci_upper"
      ],
      "title": "RiskDifferentialSummary",
      "type": "object"
    }
  },
  "description": "Presentation-ready summary of F5 subpopulation comparison.\n\nMapped from SubpopulationComparisonResult (algorithm internal type)\nby report_assembler.py.",
  "properties": {
    "n_contexts_compared": {
      "default": 0,
      "title": "N Contexts Compared",
      "type": "integer"
    },
    "comparison_valid": {
      "default": false,
      "title": "Comparison Valid",
      "type": "boolean"
    },
    "validity_notes": {
      "items": {
        "type": "string"
      },
      "title": "Validity Notes",
      "type": "array"
    },
    "context_labels": {
      "items": {
        "type": "string"
      },
      "title": "Context Labels",
      "type": "array"
    },
    "pairwise_differentials": {
      "items": {
        "$ref": "#/$defs/DifferentialEffectSummary"
      },
      "title": "Pairwise Differentials",
      "type": "array"
    },
    "risk_differentials": {
      "items": {
        "$ref": "#/$defs/RiskDifferentialSummary"
      },
      "title": "Risk Differentials",
      "type": "array"
    },
    "rank_concordance": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Rank Concordance",
      "type": "object"
    }
  },
  "title": "SubpopulationComparisonSummary",
  "type": "object"
}
